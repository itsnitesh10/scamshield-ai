# --- Environment ---
ENV=development

# --- LLM Provider (AI Investigator) ---
# Set LLM_PROVIDER to "anthropic", "openai", or "none".
# Leaving it as "none" (or leaving LLM_API_KEY blank) makes the AI
# Investigator fall back to a rule-based explanation generator, so the
# rest of the app still works fully without an API key.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional: override the API base URL (e.g. for an OpenAI-compatible proxy)
LLM_BASE_URL=

# --- OCR (Tesseract) ---
# Only needed if `tesseract` is NOT already on your system PATH.
# Windows users: set this to the full path of tesseract.exe from your
# Tesseract install (adjust to wherever you installed it), for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: usually not needed if installed via apt/brew (already on PATH).
TESSERACT_CMD=

# --- Supabase (auth, DB, storage) ---
# Create a project at https://supabase.com and fill these in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App / security ---
MAX_UPLOAD_SIZE_MB=8
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
